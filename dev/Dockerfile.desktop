# Dev preview of the full XFCE desktop in a browser (noVNC). Uses the same config as the ISO.
FROM debian:bookworm-slim
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      xfce4 xfce4-whiskermenu-plugin xfce4-terminal mousepad dbus-x11 \
      tigervnc-standalone-server tigervnc-tools novnc websockify \
      arc-theme papirus-icon-theme fonts-inter fonts-noto-core \
      python3 python3-gi gir1.2-gtk-3.0 \
    && rm -rf /var/lib/apt/lists/*
ENV PYTHONPATH=/app/src DISPLAY=:1
COPY run-desktop.sh /usr/local/bin/run-desktop
COPY web /opt/web
ENTRYPOINT ["run-desktop"]
